# Required
APP_PASSWORD=choose-a-long-random-password
GEMINI_API_KEY=your-free-key-from-aistudio.google.com/apikey
# Paste the whole service account JSON on one line, or use GOOGLE_SERVICE_ACCOUNT_B64 with the base64 of the file
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"kr-outreach@your-project.iam.gserviceaccount.com"}

# Optional (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_SEARCH_MODEL=gemini-2.5-flash
BRAIN_MODE=deep
WEB_RESEARCH=fallback
SIGNOFF=
MAX_NEWS_AGE_DAYS=90
MIN_FIT=0.30
MAX_REPAIRS=1
GEMINI_MIN_INTERVAL_SECONDS=4
ROW_DELAY_SECONDS=4
ROW_TIME_BUDGET_SECONDS=240
